{
  // DEFAULTS ONLY — DO NOT EDIT THIS FILE.
  // It is part of the installed package and every update replaces it, so any
  // change made here is silently lost the next time the app updates itself.
  //
  // Put this cabinet's real settings in:
  //     C:\ProgramData\PinballScores\appsettings.json
  // which overrides everything below and is never touched by an update. The
  // installer creates it from this file if it does not already exist.

  "PinballScores": {
    "NvramPath": "C:\\Visual Pinball\\VPinMAME\\nvram",
    "VpRegPath": "C:\\Users\\Public\\Documents\\Visual Pinball\\User\\VPReg.stg",
    "MapOverridePath": null,

    // No default: the API is self-hosted on the cabinet's own network, and its
    // address is the cabinet's business, not the package's. The service refuses to
    // start until this is set, e.g. "http://scores.example.lan/api".
    "ApiBaseUrl": "",
    // Optional. Sent as X-API-Key when set; leave empty for a server on the local
    // network that does not require one.
    "ApiKey": "",
    "Source": "office-cabinet",

    "Interval": "00:15:00",
    "DebounceDelay": "00:00:20",

    "EnableWriteBack": false,
    "BlockingProcesses": [ "VPinballX", "VPinball995", "PinballFX", "Future Pinball", "PinballArcade" ],
    "PlaceholderInitials": [ "---" ],
    "PlaceholderMarker": " ",
    "PlaceholderValue": 1,
    "IgnoredTables": []
  },

  "Updates": {
    "Enabled": true,
    "RepositoryUrl": "https://github.com/magnuspihl/pinball-scores",
    "AccessToken": "",
    "CheckInterval": "01:00:00",
    "AllowPrerelease": false,
    "ServiceName": "PinballScores",
    "RestartDelay": "00:00:20"
  }
}
