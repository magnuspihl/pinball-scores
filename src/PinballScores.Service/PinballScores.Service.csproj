<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe means no console window is ever allocated. This is the mechanism
         that keeps the app invisible; combined with running as a service (session 0,
         no desktop) stealing focus becomes structurally impossible rather than
         something we have to remember to avoid. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>PinballScores</AssemblyName>
    <RootNamespace>PinballScores.Service</RootNamespace>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(OS)' == 'Windows_NT'">win-x64</RuntimeIdentifier>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.0.0" />
    <!-- Auto-update: packaging, staging, atomic swap and rollback. -->
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PinballScores.Core\PinballScores.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Ship the service install scripts inside the package, so they land next to
         the executable on the cabinet. Otherwise registering the service would
         require cloning the repo onto the machine just to get two .ps1 files. -->
    <None Include="..\..\deploy\*.ps1" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
